{
  "name": "openbim-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Viewer of the Open BIM Platform: loads fragments within a memory budget, through a host layer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:geen-cdn": "node scripts/check-geen-cdn.mjs dist",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@openaec/design-tokens": "file:vendor/openaec-style-book/packages/tokens",
    "@openaec/i18n": "file:vendor/openaec-style-book/packages/i18n",
    "@openaec/icons": "file:vendor/openaec-style-book/packages/icons",
    "@openaec/shell": "file:vendor/openaec-style-book/packages/shell",
    "@thatopen/components": "3.6.0",
    "@thatopen/fragments": "3.6.0",
    "camera-controls": "3.1.2",
    "i18next": "^26.5.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^17.1.9",
    "three": "0.186.1",
    "web-ifc": "0.0.78"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
